# Copy this file to .env and fill in local values. Never commit .env.
# Two Cells, each with its own Postgres and Redis, no shared values between them.
# This is what makes a Cell configuration rather than code.

# Cell 1
CELL1_POSTGRES_USER=arka_cell1
CELL1_POSTGRES_PASSWORD=change-me-cell1
CELL1_POSTGRES_DB=arka_cell1
CELL1_POSTGRES_PORT=5433
CELL1_REDIS_PASSWORD=change-me-cell1-redis
CELL1_REDIS_PORT=6380

# Cell 2
CELL2_POSTGRES_USER=arka_cell2
CELL2_POSTGRES_PASSWORD=change-me-cell2
CELL2_POSTGRES_DB=arka_cell2
CELL2_POSTGRES_PORT=5434
CELL2_REDIS_PASSWORD=change-me-cell2-redis
CELL2_REDIS_PORT=6381
