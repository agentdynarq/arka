{
  "name": "@arka/identity-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP adapter for one Cell's customer-facing API. Composes identity, accounts, payments and notifications in one deployable for Phase 2 (docs/adr/0006); thin, since everything that decides behaviour lives in the composed service packages.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@arka/accounts": "workspace:*",
    "@arka/contracts": "workspace:*",
    "@arka/identity": "workspace:*",
    "@arka/ledger": "workspace:*",
    "@arka/notifications": "workspace:*",
    "@arka/payments": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.0"
  }
}
