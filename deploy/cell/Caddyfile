# Two hostnames per Cell host, both resolving to this machine via nip.io, so
# real Let's Encrypt certificates are issued without owning a domain.
#
#   cell-1.<ip>.nip.io      the customer app
#   cell-1-api.<ip>.nip.io  the Cell's identity API, called from the browser
#
# They are separate hostnames rather than paths on one host because
# NEXT_PUBLIC_IDENTITY_API_URL is baked into the customer app at build time and
# a bare origin is the least surprising thing to bake in.

{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode gzip
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$API_HOST} {
	encode gzip

	# The customer app is served from a different hostname, so its fetches are
	# cross-origin and preflighted.
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin "https://{$PUBLIC_HOST}"
			Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization, Idempotency-Key"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	# The identity app (NestJS) already emits its own Access-Control-Allow-Origin
	# header. If Caddy adds a second one the response carries two ACAO values and
	# every browser rejects it, so the fetch fails even though the API answered.
	# Replace the upstream header here rather than adding one in a header block,
	# which guarantees exactly one ACAO on the actual (non-preflight) response.
	reverse_proxy identity:3001 {
		header_down Access-Control-Allow-Origin "https://{$PUBLIC_HOST}"
		header_down Access-Control-Allow-Credentials "true"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
