# The control plane's configuration. Copy to .env on the control host.
#
# This is the only file in the deployment that names more than one Cell, and
# the only place credentials for more than one Cell coexist. That is deliberate
# and it is the boundary: the control plane can observe every Cell, and no Cell
# can observe any other.
#
# Adding a Cell is a CELL3_* block below plus cell-3 in CELL_IDS. No compose
# file and no line of application code changes.

CELL_IDS=cell-1,cell-2

# Public hostnames via nip.io, using this host's Elastic IP.
CONSOLE_HOST=arka.13.100.0.1.nip.io
API_HOST=arka-api.13.100.0.1.nip.io
GATEWAY_HOST=arka-gw.13.100.0.1.nip.io
ACME_EMAIL=hasitha@dynarq.com

# The control plane's own database. Operator actions and Cell health
# observations only, never customer data.
CONTROL_POSTGRES_USER=arka_control
CONTROL_POSTGRES_PASSWORD=
CONTROL_POSTGRES_DB=arka_control

# Cell 1, observed at its private address across the VPC boundary.
CELL1_POSTGRES_HOST=
CELL1_POSTGRES_PORT=5432
CELL1_POSTGRES_USER=arka_cell1
CELL1_POSTGRES_PASSWORD=
CELL1_POSTGRES_DB=arka_cell1
CELL1_REDIS_HOST=
CELL1_REDIS_PORT=6379
CELL1_REDIS_PASSWORD=

# Cell 2. Every value differs from Cell 1's.
CELL2_POSTGRES_HOST=
CELL2_POSTGRES_PORT=5432
CELL2_POSTGRES_USER=arka_cell2
CELL2_POSTGRES_PASSWORD=
CELL2_POSTGRES_DB=arka_cell2
CELL2_REDIS_HOST=
CELL2_REDIS_PORT=6379
CELL2_REDIS_PASSWORD=
