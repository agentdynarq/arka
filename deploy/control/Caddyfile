# Three hostnames on the control plane host, all resolving here via nip.io.
#
#   arka.<ip>.nip.io      the Recovery Console
#   arka-api.<ip>.nip.io  the control plane API, called from the console browser
#   arka-gw.<ip>.nip.io   the Gateway, which answers "which Cell is this customer in"
#
# Separate hostnames rather than paths because the Gateway and the Recovery API
# both mount controllers under /v1 and would collide on a shared origin.

{
	email {$ACME_EMAIL}
}

{$CONSOLE_HOST} {
	encode gzip

	# The Recovery Console has no operator login of its own. `operatorId` is
	# free text, which the console's own source comments state plainly and
	# USER-GUIDE repeats: RBAC exists as a real capability in @arka/identity
	# and wiring it into the console is unfinished work, not something to
	# pretend about. On a laptop that is a documented gap. On a public host it
	# means anyone who finds the URL can approve a quarantine as any operator.
	#
	# Wiring real auth into the app the night before a live demonstration is
	# how you break the demo. This closes the hole at the edge instead, where
	# it cannot affect application behaviour at all. It is not a substitute
	# for the real thing and it is not presented as one.


	reverse_proxy console:3300

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$API_HOST} {
	encode gzip

	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin "https://{$CONSOLE_HOST}"
			Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization, Idempotency-Key"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	# The recovery app (NestJS) already emits its own Access-Control-Allow-Origin.
	# Adding a second one in a header block makes the response carry two ACAO
	# values, which every browser rejects. Replace the upstream header here so
	# the actual (non-preflight) response carries exactly one.
	reverse_proxy recovery:3002 {
		header_down Access-Control-Allow-Origin "https://{$CONSOLE_HOST}"
		header_down Access-Control-Allow-Credentials "true"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}

{$GATEWAY_HOST} {
	encode gzip
	reverse_proxy gateway:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
