# AWS CDK Deployment Environment Variables
# Copy to .env in infra/cdk if environment variable overrides are preferred over cdk.json

AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
CDK_DEFAULT_REGION=ap-south-1

# Your AWS Account ID (run `aws sts get-caller-identity --query Account --output text`)
CDK_DEFAULT_ACCOUNT=123456789012

# Your Public IP for operator SSH access (CIDR format)
OPERATOR_IP=111.223.190.71/32

# Key pair name in ap-south-1
KEY_NAME=arkakeypair
