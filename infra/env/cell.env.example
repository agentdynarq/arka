# Environment variables template for an Arka Cell host (arka-cell-N)
# Place this file as /opt/arka/.env on each Cell host with relevant values.

# Cell Identification
# Set to cell-1 for Cell 1, cell-2 for Cell 2, cell-3 for Cell 3
CELL_ID=cell-1

# Cell Database (Postgres)
CELL1_POSTGRES_USER=arka_cell1
CELL1_POSTGRES_PASSWORD=change-me-cell1-secure-pass
CELL1_POSTGRES_DB=arka_cell1
CELL1_POSTGRES_PORT=5432

# Cell Redis (Event Streams & Cache)
CELL1_REDIS_PASSWORD=change-me-cell1-redis-secure-pass
CELL1_REDIS_PORT=6379

# Identity API Service
IDENTITY_PORT=3001

# Control Plane Recovery URL for FR-22 Quarantine queries before risky writes
# Replace <control-eip> with the Control Plane Elastic IP output by `cdk deploy`
RECOVERY_URL=https://arka.<control-eip>.nip.io

# Customer Web App (apps/web)
# Fixed at build time per ADR 0006: addresses this Cell specifically
NEXT_PUBLIC_IDENTITY_API_URL=https://cell-1.<cell-1-eip>.nip.io

# Judge convenience: exposes TOTP verification code for demo accounts
DEMO_MFA_ENDPOINT_ENABLED=true

# Workload Authentication Signing Secret (Must match control plane)
WORKLOAD_AUTH_SECRET=change-me-workload-auth-secret-key-32bytes
