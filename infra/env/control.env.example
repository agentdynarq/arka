# Environment variables for Arka Control Plane host (arka-control)
# Place this file as /opt/arka/.env on the control plane host.

# Control Plane Database (Postgres)
CONTROL_PLANE_POSTGRES_USER=arka_control
CONTROL_PLANE_POSTGRES_PASSWORD=change-me-control-plane-secure-pass
CONTROL_PLANE_POSTGRES_DB=arka_control
CONTROL_PLANE_POSTGRES_PORT=5432

# Gateway configuration
# Lists all active Cells in the cluster, comma-separated
CELL_IDS=cell-1,cell-2
GATEWAY_PORT=8080

# Recovery Service (Control Plane API & Health Observer)
RECOVERY_PORT=3002

# Recovery Console (Operator Web UI)
CONSOLE_PORT=3000

# Cell Endpoint Definitions for Control Plane routing & health check observation
# Replace <cell-1-eip> and <cell-2-eip> with the Elastic IPs output by `cdk deploy`
CELL1_URL=https://cell-1.<cell-1-eip>.nip.io
CELL2_URL=https://cell-2.<cell-2-eip>.nip.io
CELL1_IDENTITY_API_URL=https://cell-1.<cell-1-eip>.nip.io
CELL2_IDENTITY_API_URL=https://cell-2.<cell-2-eip>.nip.io

# Workload Authentication Signing Secrets (Shared with workload-auth)
WORKLOAD_AUTH_SECRET=change-me-workload-auth-secret-key-32bytes
